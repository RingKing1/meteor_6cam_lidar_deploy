+def draw_occ_topview(occ, lidar_bev=None, size=360, rng_m=24.0, margin_th=0.3):
+    """North-up (front-up) 2-D top view of the OCC prediction, ego centred.
+
+    occ is [C,Z,H,W] logits with the ego-frame convention
+    row=(40-x)/0.4, col=(40-y)/0.4. The height axis is collapsed per cell by
+    the best occupied class vs free. Optional LiDAR ground points (raster
+    ch3 occupied, ch1 max-z low) are drawn as pale dots for a direct
+    camera-vs-LiDAR alignment check. Returns a size x size BGR image.
+    """
+    # BGR semantic colours tuned for a small dark panel: road bright green,
+    # dynamic objects warm/bright, vegetation/buildings dimmed.
+    # index: 0 free,1 obstacle,2 vehicle,3 2wheel,4 ped,5 road,
+    #        6 sidewalk,7 vegetation,8 building,9 pole/sign
+    top_pal = np.array([
+        [0, 0, 0],        # free
+        [150, 150, 150],  # obstacle
+        [220, 90, 0],     # vehicle (blue)
+        [0, 170, 255],    # 2wheel (orange)
+        [0, 0, 255],      # pedestrian (red)
+        [70, 200, 90],    # road (green)
+        [50, 110, 70],    # sidewalk
+        [36, 84, 36],     # vegetation
+        [64, 64, 64],    # building
+        [0, 220, 220],   # pole/sign (yellow)
+    ], np.uint8)
+    img = np.full((size, size, 3), 18, np.uint8)
+    n = int(rng_m / 0.4)                    # cells per half-side
+    s = size / (2 * n)                      # px per cell
+    for g in range(-n, n + 1, 25):         # 10 m grid
+        p = int((g + n) * s)
+        cv2.line(img, (p, 0), (p, size), (42, 42, 42), 1)
+        cv2.line(img, (0, p), (size, p), (42, 42, 42), 1)
+    o = np.asarray(occ, np.float32)
+    if o.ndim == 5:
+        o = o[0]
+    c0 = o.shape[-1] // 2 - n
+    oc = o[:, :10, c0:c0 + 2 * n, c0:c0 + 2 * n]      # [C,<=10,2n,2n]
+    free = oc[0]                                        # [Z,h,w]
+    # A cell keeps a class if that class beats free at ANY height bin (road
+    # sits at the ground bin and loses to a single-argmax over tall clutter
+    # then pick colour by display priority: dynamic > drivable > static.
+    PRIORITY = [4, 3, 2, 5, 6, 9, 1, 7, 8]             # occ class ids
+    hit = np.zeros((2 * n, 2 * n), np.uint8)
+    for cl in PRIORITY:
+        mz = (oc[cl] - free).max(0) > margin_th
+        hit = np.where(mz & (hit == 0), cl, hit)
+    cls = hit
+    keep = hit > 0
+    layer = top_pal[np.clip(cls, 0, len(top_pal) - 1)]
+    layer = cv2.resize(layer, (size, size), interpolation=cv2.INTER_NEAREST)
+    mk = cv2.resize(keep.astype(np.uint8), (size, size),
+                    interpolation=cv2.INTER_NEAREST).astype(bool)
+    img[mk] = layer[mk]
+    if lidar_bev is not None:
+        _lmode = os.environ.get("METEOR_OCC_TOP_LIDAR", "obstacle")
+        l = np.asarray(lidar_bev, np.float32)
+        if l.ndim == 4:
+            l = l[0]
+        r0, r1 = int((80 - rng_m) / 0.4), int((80 + rng_m) / 0.4)
+        cc0, cc1 = int((50 - rng_m) / 0.4), int((50 + rng_m) / 0.4)
+        if _lmode == "ground":
+            sel = (l[3] > 0) & (l[1] < 0.3)
+            lcol = np.array([110, 200, 170], np.float32)
+        else:                               # default: sparse obstacle returns
+            sel = (l[3] > 0) & (l[1] > 0.3)
+            lcol = np.array([90, 220, 255], np.float32)   # warm yellow dots
+        g = sel[r0:r1, cc0:cc1]
+        g = cv2.resize(g.astype(np.uint8), (size, size),
+                       interpolation=cv2.INTER_NEAREST).astype(bool)
+        img[g] = (0.45 * img[g] + 0.55 * lcol).astype(np.uint8)
+    c = size // 2
+    cv2.arrowedLine(img, (c, c), (c, c - int(2.2 * s * 10)),
+                    (0, 0, 255), 2, tipLength=0.25)
+    cv2.drawMarker(img, (c, c), (0, 255, 255),
+                   cv2.MARKER_TRIANGLE_UP, 14, 2)
+    return img
+
